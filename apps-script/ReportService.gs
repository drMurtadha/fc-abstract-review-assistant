const ReportService={
  generate:function(payload){if(!payload.submissionId)throw new Error('submissionId is required.');var submission=SubmissionService.get(payload.submissionId),doc=DocumentApp.create('Abstract Review Report - '+payload.submissionId),body=doc.getBody();body.appendHeading('Faculty of Computing',DocumentApp.ParagraphHeading.HEADING2);body.appendHeading('Thesis Abstract Review Report',DocumentApp.ParagraphHeading.TITLE);[['Student Name',submission.student_name],['Matric No.',submission.matric_no],['Programme',submission.programme],['Thesis Title',submission.thesis_title],['Status',submission.status]].forEach(function(row){body.appendParagraph(row[0]+': '+row[1]);});body.appendHeading('Checklist',DocumentApp.ParagraphHeading.HEADING1);submission.review_items.forEach(function(item){body.appendParagraph(item.item_code+' — '+item.item_description+' ['+(item.reviewer_result||item.auto_result)+']');});doc.saveAndClose();var file=DriveApp.getFileById(doc.getId()),folder=DriveApp.getFolderById(scriptProperty_('GENERATED_REPORTS_FOLDER_ID'));file.moveTo(folder);var pdf=folder.createFile(file.getAs(MimeType.PDF)).setName('abstract_review_report_'+payload.submissionId+'.pdf');AuditService.log(payload.submissionId,'generate_report',payload.reviewerName,{pdfUrl:pdf.getUrl()});return{googleDocUrl:file.getUrl(),pdfUrl:pdf.getUrl()};
  }
};
