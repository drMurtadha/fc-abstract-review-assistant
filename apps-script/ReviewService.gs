const ReviewService = {
  saveItems:function(payload){if(!payload.submissionId||!Array.isArray(payload.items))throw new Error('submissionId and items are required.');payload.items.forEach(function(item){SheetService.appendObject('Review_Items',{submission_id:payload.submissionId,section:item.section,item_code:item.itemCode,item_description:item.itemDescription,auto_result:item.autoResult,reviewer_result:item.reviewerResult,comment:item.comment,evidence:item.evidence,source:item.source||'rule-based',updated_at:now_()});});AuditService.log(payload.submissionId,'save_review_items','system',{count:payload.items.length});return{saved:payload.items.length};},
  saveDecision:function(payload){var allowed=['Acceptable - No correction required','Acceptable - Minor correction required','Revision required before acceptance'];if(allowed.indexOf(payload.finalDecision)<0)throw new Error('Invalid final decision.');SheetService.appendObject('Reviewer_Decisions',{submission_id:payload.submissionId,final_decision:payload.finalDecision,main_corrections:payload.mainCorrections,reviewer_name:payload.reviewerName,decision_date:payload.decisionDate||now_(),created_at:now_()});this.updateStatus({submissionId:payload.submissionId,status:payload.finalDecision});AuditService.log(payload.submissionId,'save_reviewer_decision',payload.reviewerName,{decision:payload.finalDecision});return{status:payload.finalDecision};},
  updateStatus:function(payload){var allowed=['Draft','Pre-checked','Pending reviewer decision','Acceptable - No correction required','Acceptable - Minor correction required','Revision required before acceptance'];if(allowed.indexOf(payload.status)<0)throw new Error('Invalid status.');var sheet=SheetService.sheet('Submissions'),values=sheet.getDataRange().getValues(),headers=values[0],idCol=headers.indexOf('submission_id'),statusCol=headers.indexOf('status'),updatedCol=headers.indexOf('updated_at');for(var i=1;i<values.length;i++){if(values[i][idCol]===payload.submissionId){sheet.getRange(i+1,statusCol+1).setValue(payload.status);sheet.getRange(i+1,updatedCol+1).setValue(now_());return{updated:true};}}throw new Error('Submission not found.');}
};
